+void CZone::SetPreventSleep(bool value)
+{
+    m_preventSleep = value;
+
+    if (m_preventSleep && !zoneTimerToken_.has_value())
+    {
+        createZoneTimers();
+        ShowInfoFmt("Zone {} ({}) forced awake by SetPreventSleep.", GetID(), getName());
+    }
+}
